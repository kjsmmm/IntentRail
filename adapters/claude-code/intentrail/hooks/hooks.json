{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event SessionStart", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event UserPromptSubmit", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event PreToolUse", "timeout": 5}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event PreCompact", "timeout": 5}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event PostCompact", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event Stop", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND}} hook --host claude-code --event SessionEnd", "timeout": 3}]}]
  }
}

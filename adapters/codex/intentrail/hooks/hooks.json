{
  "description": "IntentRail lifecycle binding, checkpointing, and Gate enforcement.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event SessionStart", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event SessionStart", "timeout": 5, "additionalContextLimit": 6000}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event UserPromptSubmit", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event UserPromptSubmit", "timeout": 5, "additionalContextLimit": 6000}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event PreToolUse", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event PreToolUse", "timeout": 5, "statusMessage": "Checking IntentRail alignment"}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event PreCompact", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event PreCompact", "timeout": 5}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event PostCompact", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event PostCompact", "timeout": 5, "additionalContextLimit": 6000}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event Stop", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event Stop", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "{{INTENTRAIL_COMMAND_UNIX}} hook --host codex --event SessionEnd", "commandWindows": "{{INTENTRAIL_COMMAND_WINDOWS}} hook --host codex --event SessionEnd", "timeout": 3}]}]
  }
}

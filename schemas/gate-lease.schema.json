{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-lease.schema.json",
  "title": "IntentRail turn gate lease",
  "type": "object",
  "required": ["schema_version", "lease_id", "decision", "contract_id", "contract_version", "event_head_hash", "binding_id", "turn_or_prompt_id", "allowed_scopes", "issued_at", "expires_at", "lease_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "lease_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "decision": {"type": "string", "const": "PASS"},
    "contract_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "contract_version": {"type": "integer", "minimum": 1},
    "event_head_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "binding_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "turn_or_prompt_id": {"type": "string", "minLength": 1},
    "allowed_scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "action_summary": {"type": ["string", "null"], "maxLength": 1000},
    "intent_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid"}, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid"}, "uniqueItems": true},
    "affected_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "lease_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-ticket.schema.json",
  "title": "IntentRail one-shot high-risk action ticket",
  "type": "object",
  "required": ["schema_version", "ticket_id", "lease_id", "decision", "contract_id", "contract_version", "binding_id", "action_class", "action_summary", "intent_refs", "decision_refs", "affected_scopes", "targets", "target_fingerprint", "issued_at", "expires_at", "consumed_at", "ticket_hash"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "ticket_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "lease_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "decision": {"type": "string", "const": "PASS"},
    "contract_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "contract_version": {"type": "integer", "minimum": 1},
    "binding_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "action_class": {"type": "string", "enum": ["destructive_local", "external_write", "permission_change", "secret_access", "release", "other_high_risk"]},
    "action_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "intent_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/uuid"}, "uniqueItems": true},
    "decision_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid"}, "uniqueItems": true},
    "affected_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "target_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "consumed_at": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "ticket_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": true
}

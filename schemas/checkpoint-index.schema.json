{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint-index.schema.json",
  "title": "IntentRail checkpoint index",
  "type": "object",
  "required": ["schema_version", "contract_id", "updated_at", "checkpoints"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "contract_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "created_at", "contract_version", "purpose", "file_hash", "recoverable"],
        "properties": {
          "checkpoint_id": {"$ref": "common.schema.json#/$defs/uuid"},
          "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "contract_version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "file_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "recoverable": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
